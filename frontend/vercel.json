{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source": "/api/:caminho*", "destination": "https://geovale.onrender.com/api/:caminho*"},
    {"source": "/((?!assets/).*)", "destination": "/index.html"}
  ]
}
